{
  "manifest_version": 3,
  "name": "HackMD PDF Exporter",
  "version": "1.0.0",
  "description": "免費匯出 HackMD 筆記為 PDF 檔案",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://hackmd.io/*",
    "https://*.hackmd.io/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://hackmd.io/*",
        "https://*.hackmd.io/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
