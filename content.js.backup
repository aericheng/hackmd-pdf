// 監聽來自 popup 的訊息
chrome.runtime.onMessage.addListener(function(request, sender, sendResponse) {
  if (request.action === 'exportPDF') {
    exportToPDF()
      .then(() => {
        sendResponse({ success: true });
      })
      .catch(error => {
        console.error('PDF 匯出錯誤:', error);
        sendResponse({ success: false, error: error.message });
      });

    // 返回 true 表示會非同步發送回應
    return true;
  }
});

// 匯出 PDF 的主函式
async function exportToPDF() {
  try {
    // 取得文件標題
    const titleElement = document.querySelector('title');
    const documentTitle = titleElement ? titleElement.textContent.trim() : 'hackmd-export';

    // 取得 HackMD 的渲染內容區域
    // HackMD 使用不同的選擇器，嘗試多種可能性
    let contentElement = document.querySelector('.ui-view-area') ||
                        document.querySelector('.markdown-body') ||
                        document.querySelector('#doc') ||
                        document.querySelector('.CodeMirror-scroll');

    if (!contentElement) {
      // 如果是在編輯模式，嘗試切換到預覽模式
      const viewModeBtn = document.querySelector('.ui-view-btn') ||
                          document.querySelector('[data-mode="view"]');
      if (viewModeBtn) {
        viewModeBtn.click();
        // 等待內容載入
        await new Promise(resolve => setTimeout(resolve, 1000));
        contentElement = document.querySelector('.ui-view-area') ||
                        document.querySelector('.markdown-body');
      }
    }

    if (!contentElement) {
      throw new Error('無法找到 HackMD 內容區域，請確保在檢視模式下');
    }

    // 等待 LaTeX/MathJax 渲染完成
    await waitForMathRender();

    // 使用瀏覽器的列印功能來產生 PDF
    window.print();

    return true;
  } catch (error) {
    console.error('匯出 PDF 失敗:', error);
    throw error;
  }
}

// 等待數學公式渲染完成
async function waitForMathRender() {
  console.log('開始等待數學公式渲染...');

  // 先滾動整個頁面以觸發所有懶加載的數學公式渲染
  await scrollToTriggerLazyLoad();

  // 先給予初始等待時間讓 MathJax/KaTeX 開始工作
  await new Promise(resolve => setTimeout(resolve, 1500));

  // 等待 MathJax 渲染
  if (window.MathJax) {
    console.log('偵測到 MathJax');

    // MathJax v3
    if (window.MathJax.typesetPromise) {
      try {
        await window.MathJax.typesetPromise();
        console.log('MathJax v3 渲染完成');
        // 再等一下讓渲染完全完成
        await new Promise(resolve => setTimeout(resolve, 1000));
      } catch (e) {
        console.warn('MathJax v3 渲染錯誤:', e);
      }
    }

    // MathJax v2
    if (window.MathJax.Hub && window.MathJax.Hub.Queue) {
      await new Promise(resolve => {
        window.MathJax.Hub.Queue(['Typeset', window.MathJax.Hub]);
        window.MathJax.Hub.Queue(resolve);
      });
      console.log('MathJax v2 渲染完成');
      await new Promise(resolve => setTimeout(resolve, 1000));
    }
  }

  // 持續檢查直到已渲染數量穩定（最多等待 15 秒）
  const maxWaitTime = 15000; // 15 秒
  const checkInterval = 500; // 每 500ms 檢查一次
  const startTime = Date.now();
  let lastRenderedCount = 0;
  let stableCount = 0;

  while (Date.now() - startTime < maxWaitTime) {
    // 檢查已渲染的數學公式
    const renderedMath = document.querySelectorAll(
      '.MathJax, .MathJax_Display, .MathJax_SVG, .MathJax_CHTML, ' +
      '.katex, .katex-display, ' +
      'mjx-container, mjx-math, ' +
      'span[class*="mjx-"]'
    );

    const currentCount = renderedMath.length;
    console.log(`已渲染數學公式: ${currentCount}`);

    // 如果數量沒變化，增加穩定計數
    if (currentCount === lastRenderedCount && currentCount > 0) {
      stableCount++;
      console.log(`數量穩定 ${stableCount} 次`);

      // 如果連續 3 次檢查數量都一樣，認為渲染完成
      if (stableCount >= 3) {
        console.log('數學公式數量已穩定，認為渲染完成');
        break;
      }
    } else {
      stableCount = 0; // 重置穩定計數
    }

    lastRenderedCount = currentCount;
    await new Promise(resolve => setTimeout(resolve, checkInterval));
  }

  // 最後再等待一點時間確保 SVG/字體完全載入
  await new Promise(resolve => setTimeout(resolve, 1500));
  console.log('數學公式渲染等待完成');
}

// 滾動頁面以觸發懶加載的內容
async function scrollToTriggerLazyLoad() {
  console.log('開始滾動頁面以觸發懶加載...');

  // 儲存原始滾動位置
  const originalScrollY = window.scrollY || window.pageYOffset;

  // 取得文檔總高度
  const documentHeight = Math.max(
    document.body.scrollHeight,
    document.body.offsetHeight,
    document.documentElement.clientHeight,
    document.documentElement.scrollHeight,
    document.documentElement.offsetHeight
  );

  const viewportHeight = window.innerHeight;

  console.log(`文檔高度: ${documentHeight}, 視窗高度: ${viewportHeight}`);

  // 如果內容不需要滾動，直接返回
  if (documentHeight <= viewportHeight) {
    console.log('內容無需滾動');
    return;
  }

  // 分 20 段慢慢滾動到底部，讓用戶能看到滾動過程
  const steps = 20;
  const stepSize = documentHeight / steps;

  for (let i = 1; i <= steps; i++) {
    window.scrollTo({
      top: stepSize * i,
      behavior: 'auto' // 不使用 smooth，確保立即滾動
    });
    console.log(`滾動到位置: ${Math.round(stepSize * i)}`);
    await new Promise(resolve => setTimeout(resolve, 150)); // 每步延遲 150ms
  }

  console.log('已滾動到底部，等待渲染...');
  await new Promise(resolve => setTimeout(resolve, 500));

  // 滾動回頂部
  window.scrollTo({
    top: 0,
    behavior: 'auto'
  });
  console.log('已滾動回頂部');
  await new Promise(resolve => setTimeout(resolve, 300));

  // 再次快速滾動到底部，確保所有內容都被觸發
  for (let i = 1; i <= steps; i++) {
    window.scrollTo({
      top: stepSize * i,
      behavior: 'auto'
    });
    await new Promise(resolve => setTimeout(resolve, 50)); // 第二次滾動快一點
  }

  await new Promise(resolve => setTimeout(resolve, 500));

  // 恢復原始滾動位置
  window.scrollTo({
    top: originalScrollY,
    behavior: 'auto'
  });

  console.log(`滾動完成，已恢復到原始位置: ${originalScrollY}`);
}

// 新增列印樣式最佳化（避免重複注入）
if (!document.getElementById('hackmd-pdf-exporter-styles')) {
  const style = document.createElement('style');
  style.id = 'hackmd-pdf-exporter-styles';
  style.textContent = `
  @media print {
    /* 隱藏不需要列印的元素 */
    .ui-edit-area,
    .ui-toolbar,
    .navbar,
    nav,
    header,
    footer,
    .ui-toc,
    .ui-toc-dropdown,
    button,
    .ui-status-bar {
      display: none !important;
    }

    /* 最佳化列印區域 */
    .ui-view-area,
    .markdown-body {
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 !important;
      padding: 20px !important;
    }

    /* 放大字體 */
    body,
    .ui-view-area,
    .markdown-body {
      font-size: 14pt !important;
      line-height: 1.6 !important;
    }

    /* 標題字體大小 */
    h1 {
      font-size: 28pt !important;
      margin-bottom: 0.5em !important;
    }

    h2 {
      font-size: 22pt !important;
      margin-top: 1em !important;
      margin-bottom: 0.5em !important;
    }

    h3 {
      font-size: 18pt !important;
      margin-top: 0.8em !important;
      margin-bottom: 0.4em !important;
    }

    h4 {
      font-size: 16pt !important;
    }

    /* 段落間距 */
    p {
      font-size: 14pt !important;
      margin-bottom: 0.8em !important;
    }

    /* 列表字體 */
    li {
      font-size: 14pt !important;
      margin-bottom: 0.3em !important;
    }

    /* 程式碼字體 */
    code {
      font-size: 12pt !important;
    }

    pre code {
      font-size: 11pt !important;
    }

    /* 表格字體 */
    table {
      font-size: 13pt !important;
    }

    th, td {
      padding: 8px !important;
    }

    /* 超連結處理 - 在列印時顯示完整 URL */
    a[href]:after {
      content: " (" attr(href) ")";
      font-size: 90%;
      color: #666;
      word-wrap: break-word;
    }

    /* 避免內部錨點連結顯示 # */
    a[href^="#"]:after,
    a[href^="javascript:"]:after {
      content: "";
    }

    /* 連結樣式 */
    a {
      color: #0066cc !important;
      text-decoration: underline !important;
    }

    /* 確保程式碼區塊不會被截斷 */
    pre, code {
      white-space: pre-wrap !important;
      word-wrap: break-word !important;
      page-break-inside: avoid;
    }

    /* 最佳化表格列印 */
    table {
      page-break-inside: avoid;
    }

    /* 避免標題在頁面底部斷開 */
    h1, h2, h3, h4, h5, h6 {
      page-break-after: avoid;
    }

    /* 確保圖片不會溢出 */
    img {
      max-width: 100% !important;
      page-break-inside: avoid;
    }

    /* 確保 MathJax/KaTeX 數學公式正常顯示 */
    .MathJax,
    .MathJax_Display,
    .MathJax_SVG,
    .MathJax_SVG_Display,
    .katex,
    .katex-display,
    .katex-html,
    mjx-container,
    mjx-math {
      display: inline-block !important;
      visibility: visible !important;
      opacity: 1 !important;
      page-break-inside: avoid;
    }

    /* 確保行內數學公式正確對齊 */
    .MathJax,
    .katex {
      vertical-align: middle !important;
    }

    /* 確保區塊數學公式置中顯示 */
    .MathJax_Display,
    .katex-display,
    mjx-container[display="true"] {
      display: block !important;
      text-align: center !important;
      margin: 1em 0 !important;
    }

    /* 確保 SVG 數學公式正確顯示 */
    .MathJax_SVG svg,
    .katex svg {
      display: inline-block !important;
      max-width: 100% !important;
    }
  }
`;
  document.head.appendChild(style);
  console.log('HackMD PDF 匯出工具樣式已載入');
} else {
  console.log('HackMD PDF 匯出工具樣式已存在，跳過');
}

console.log('HackMD PDF 匯出工具 content script 已載入');
